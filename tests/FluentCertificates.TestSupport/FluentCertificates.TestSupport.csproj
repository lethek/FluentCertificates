<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>FluentCertificates</RootNamespace>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <Authors>Michael Monsour</Authors>
    <Copyright>Copyright © Michael Monsour 2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" Version="1.65.68" />
  </ItemGroup>

  <!--
    Compiles against the net8.0 build, but every consumer is a test project that deploys its own
    target framework's copy, so at runtime the capability checks run against the loaded assembly and
    report what that framework can actually do.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FluentCertificates.Extensions\FluentCertificates.Extensions.csproj" />
  </ItemGroup>

</Project>
